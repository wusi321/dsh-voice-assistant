{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-voice-assistant.local/schemas/model-manifest.json",
  "title": "DSH Voice Assistant model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "models"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "engine",
        "task",
        "language",
        "version",
        "download_url",
        "sha256",
        "size",
        "license",
        "license_url",
        "commercial_use",
        "redistributable",
        "supported_platforms",
        "sample_rate",
        "capabilities",
        "verified"
      ],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "task": { "enum": ["vad", "wake", "asr", "tts", "speaker"] },
        "language": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "download_url": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri" },
        "commercial_use": { "type": "boolean" },
        "redistributable": { "type": "boolean" },
        "supported_platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "sample_rate": { "type": "integer", "minimum": 8000 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verified": { "type": "boolean", "const": true }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "engine",
        "task",
        "language",
        "version",
        "download_url",
        "license",
        "license_url",
        "commercial_use",
        "redistributable",
        "supported_platforms",
        "sample_rate",
        "capabilities",
        "verified"
      ],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "task": { "enum": ["vad", "wake", "asr", "tts", "speaker"] },
        "language": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "download_url": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" }
        },
        "sha256": { "type": ["string", "null"] },
        "size": { "type": ["integer", "null"] },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "format": "uri" },
        "commercial_use": { "type": "boolean" },
        "redistributable": { "type": "boolean" },
        "supported_platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "sample_rate": { "type": "integer", "minimum": 8000 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verified": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      }
    }
  }
}

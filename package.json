{
  "name": "dsh-voice-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, cross-platform voice assistant for DeepSeek Harness with dsh-pet avatar integration.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @dsh-voice/protocol build && pnpm -r test",
    "typecheck": "pnpm --filter @dsh-voice/protocol build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.4"
  }
}
